DATABASE_URL=file:./prisma/dev.db
HOST=127.0.0.1
PORT=3000
# Docker publishes the frontend here; the API stays internal.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Leave empty outside Docker unless the API is behind a trusted reverse proxy.
TRUST_PROXY=
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
AI_MAX_QUESTIONS_PER_REQUEST=10
AI_DAILY_BUDGET_USD=1
AI_MOCK_MODE=false
# Set current prices from Google before live calls. USD per 1 million tokens.
AI_PRIMARY_INPUT_USD_PER_MILLION=
AI_PRIMARY_OUTPUT_USD_PER_MILLION=
AI_ADVANCED_INPUT_USD_PER_MILLION=
AI_ADVANCED_OUTPUT_USD_PER_MILLION=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192
AI_RATE_LIMIT_PER_MINUTE=10
# JSON array. Generate long random tokens; do not commit actual credentials.
# Students are provisioned via the admin endpoint. Store only SHA-256 of their token.
AUTH_CREDENTIALS_JSON=[{"token":"replace-with-a-random-admin-token-at-least-32-chars","role":"admin","actorId":"admin-1"},{"token":"replace-with-a-random-teacher-token-at-least-32-chars","role":"teacher","actorId":"teacher-1"}]
