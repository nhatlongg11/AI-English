{
  "name": "tenselab-ai-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:accounts": "tsx scripts/seed-accounts.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:live:app": "tsx scripts/verify-live-app.ts",
    "test:live:roles": "tsx scripts/verify-roles.ts",
    "test:live:classroom": "tsx scripts/verify-classroom.ts",
    "test:live:ai-support": "tsx scripts/verify-ai-support.ts",
    "check": "tsc --noEmit",
    "dev:web": "vite --config frontend/vite.config.ts",
    "check:web": "tsc --noEmit -p frontend/tsconfig.json",
    "build:web": "npm run check:web && vite build --config frontend/vite.config.ts",
    "preview:web": "vite preview --config frontend/vite.config.ts",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "lint": "eslint frontend/src frontend/vite.config.ts frontend/vitest.config.ts src scripts tests",
    "verify:client": "tsx scripts/verify-client-secrets.ts"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "2.30.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shepherd.js": "15.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
